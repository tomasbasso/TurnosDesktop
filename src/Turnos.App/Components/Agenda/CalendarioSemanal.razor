@using System.Globalization
@using Turnos.Core
@using Turnos.Core.Entidades
@implements IHandleEvent
@implements IDisposable
@inject EstadoApp Estado

@{
    var ahora = DateTime.Now;
    var proximo = ProximoTurno(ahora);
    var semanaActual = Dias().Any(d => d == DateTime.Today);
    var ahoraVisible = semanaActual && AhoraVisible(ahora);
    var topAhora = Desplazamiento(TimeOnly.FromDateTime(ahora));
    var dias = Dias().ToList();
}

<div class="cal">

    <div class="canal">
        <div class="canal-cabecera" style="height:@(CabeceraAlto)px"></div>
        <div class="canal-cuerpo" style="height:@(Px(AltoTotal))px">
            @foreach (var hora in Horas().Where(h => Desplazamiento(h) > 0 && !(ahoraVisible && Math.Abs(Desplazamiento(h) - topAhora) < 14)))
            {
                <span class="hora" style="top:@(Px(Desplazamiento(hora)))px">@hora.ToString("HH:mm")</span>
            }
            @if (ahoraVisible)
            {
                <span class="ahora-etiqueta" style="top:@(Px(topAhora))px">@ahora.ToString("HH:mm")</span>
            }
        </div>
    </div>

    @for (var i = 0; i < dias.Count; i++)
    {
        var dia = dias[i];
        var indice = i;
        var delDia = TurnosDe(dia).ToList();
        var esHoy = dia == DateTime.Today;
        var momento = esHoy ? "hoy" : dia < DateTime.Today ? "pasado" : "";

        <div class="dia @momento">

            <div class="cabecera" style="height:@(CabeceraAlto)px">
                <div>
                    <div class="dia-nombre">@dia.ToString("ddd", Es).TrimEnd('.')</div>
                    <div class="dia-numero">@dia.Day</div>
                </div>
                <div class="dia-info">
                    @ResumenDelDia(dia, delDia, ahora)
                    <div class="densidad"><i style="width:@(Px(Ocupacion(delDia) * 100))%"></i></div>
                </div>
            </div>

            <div class="cuerpo" style="height:@(Px(AltoTotal))px"
                 @onclick="@(e => ClickEnVacio(dia, e))"
                 @onmousemove="@(e => AlMoverEnDia(dia, e))"
                 @onmouseleave="AlSalirDelDia">

                @foreach (var hora in Horas())
                {
                    foreach (var (marca, clase) in new[] { (hora, "linea"), (hora.AddMinutes(30), "linea media") })
                    {
                        var y = Desplazamiento(marca);
                        if (y > 0 && y < AltoTotal)
                        {
                            <div class="@clase" style="top:@(Px(y))px"></div>
                        }
                    }
                }

                @if (esHoy && ahoraVisible)
                {
                    <div class="velo" style="height:@(Px(topAhora))px"></div>
                }

                @if (ahoraVisible)
                {
                    <div class="ahora @(esHoy ? "con-punto" : "")" style="top:@(Px(topAhora))px"></div>
                }

                @if (fantasmaDia == dia && fantasmaMinutos is { } minutos)
                {
                    <div class="fantasma" style="top:@(Px(minutos * Escala + 1))px; height:@(Px(AltoFantasma(dia, minutos)))px">
                        <b>+ @HoraInicio.AddMinutes(minutos).ToString("HH:mm")</b> Nuevo turno
                    </div>
                }

                @foreach (var turno in delDia)
                {
                    var compacto = Alto(turno) < 46;
                    <div class="turno @ClaseTurno(turno, proximo) @(compacto ? "compacto" : "")"
                         style="top:@(Px(Desplazamiento(TimeOnly.FromDateTime(turno.Inicio)) + 1))px; height:@(Px(Alto(turno) - 3))px"
                         @onclick:stopPropagation="true"
                         @onmousemove:stopPropagation="true"
                         @onclick="@(() => AbrirTurno(turno))"
                         @onmouseenter="@(() => AlEntrarEnTurno(turno))"
                         @onmouseleave="AlSalirDeTurno">
                        @if (turno.Estado == EstadoTurno.Atendido)
                        {
                            <svg class="tilde" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                        }
                        <div class="nombre">@turno.NombreMostrado</div>
                        @if (compacto)
                        {
                            <span class="hora-turno">@turno.Inicio.ToString("HH:mm")</span>
                        }
                        else
                        {
                            <div class="meta">@Meta(turno, proximo, ahora)</div>
                        }
                    </div>
                }

                @if (turnoBajoMouse is { } vistazo && vistazo.Inicio.Date == dia.Date)
                {
                    <div class="vistazo @(indice >= dias.Count - 2 ? "a-la-izquierda" : "")"
                         style="top:@(Px(Math.Clamp(Desplazamiento(TimeOnly.FromDateTime(vistazo.Inicio)) - 8, 4, Math.Max(AltoTotal - 210, 4))))px">
                        <div class="vistazo-nombre">@vistazo.NombreMostrado</div>
                        <div class="vistazo-cuando">
                            @vistazo.Inicio.ToString("ddd d", Es).Replace(".", "") · @vistazo.Inicio.ToString("HH:mm")–@vistazo.Fin.ToString("HH:mm") · @NombreEstado(vistazo.Estado)
                        </div>
                        @if (vistazo.Paciente is { } paciente)
                        {
                            <dl>
                                <dt>Obra social</dt><dd>@(paciente.ObraSocial ?? "Particular")</dd>
                                <dt>Teléfono</dt><dd>@(paciente.Telefono ?? "—")</dd>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(paciente.Observaciones))
                            {
                                <div class="vistazo-aviso">@paciente.Observaciones</div>
                            }
                        }
                        else
                        {
                            <div class="vistazo-sin-ficha">Sin ficha de paciente</div>
                        }
                        @if (NotaDelTurno(vistazo) is { } nota)
                        {
                            <div class="vistazo-nota">“@nota”</div>
                        }
                        <div class="vistazo-pie">Click para abrir el turno</div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DateOnly Lunes { get; set; }
    [Parameter] public List<Turno> Turnos { get; set; } = [];
    [Parameter] public TimeOnly HoraInicio { get; set; } = new(7, 0);
    [Parameter] public TimeOnly HoraFin { get; set; } = new(21, 0);
    [Parameter] public bool MostrarDomingo { get; set; }
    [Parameter] public EventCallback<DateTime> AlClickEnVacio { get; set; }
    [Parameter] public EventCallback<Turno> AlClickEnTurno { get; set; }

    /// <summary>Pixeles por minuto. 30 min = 36 px.</summary>
    private const double Escala = 1.2;
    private const int CabeceraAlto = 58;

    private static readonly CultureInfo Es = new("es-AR");

    private double AltoTotal => (HoraFin - HoraInicio).TotalMinutes * Escala;

    // El hueco "+ Nuevo turno" que sigue al mouse y la ficha rápida del turno bajo el mouse.
    private DateTime? fantasmaDia;
    private double? fantasmaMinutos;
    private Turno? turnoBajoMouse;

    // Mover el mouse dispara muchos eventos; solo se redibuja cuando algo visible cambió.
    private bool redibujar;

    // Refresca la línea de "ahora" y el "en N min" del próximo turno.
    private System.Threading.Timer? reloj;

    protected override void OnInitialized()
    {
        reloj = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(60 - DateTime.Now.Second),
            TimeSpan.FromMinutes(1));
    }

    public void Dispose() => reloj?.Dispose();

    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg)
    {
        await callback.InvokeAsync(arg);
        if (redibujar)
        {
            redibujar = false;
            StateHasChanged();
        }
    }

    private static string Px(double valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);

    private IEnumerable<DateTime> Dias()
    {
        var cantidad = MostrarDomingo ? 7 : 6;
        for (var i = 0; i < cantidad; i++)
            yield return Lunes.ToDateTime(TimeOnly.MinValue).AddDays(i);
    }

    private IEnumerable<TimeOnly> Horas()
    {
        for (var h = HoraInicio.Hour; h <= HoraFin.Hour; h++)
            yield return new TimeOnly(h, 0);
    }

    private double Desplazamiento(TimeOnly momento) =>
        (momento - HoraInicio).TotalMinutes * Escala;

    private double Alto(Turno turno) =>
        Math.Max(turno.DuracionMinutos * Escala, 18);

    private bool AhoraVisible(DateTime ahora)
    {
        var hora = TimeOnly.FromDateTime(ahora);
        return hora >= HoraInicio && hora <= HoraFin;
    }

    private IEnumerable<Turno> TurnosDe(DateTime dia) =>
        Turnos.Where(t => t.Inicio.Date == dia.Date && t.Estado != EstadoTurno.Cancelado)
              .OrderBy(t => t.Inicio);

    /// <summary>El primer turno programado de hoy que todavía no terminó.</summary>
    private Turno? ProximoTurno(DateTime ahora) =>
        Turnos.Where(t => t.Inicio.Date == ahora.Date && t.Estado == EstadoTurno.Programado && t.Fin > ahora)
              .OrderBy(t => t.Inicio)
              .FirstOrDefault();

    private double Ocupacion(List<Turno> delDia)
    {
        var total = (HoraFin - HoraInicio).TotalMinutes;
        return total <= 0 ? 0 : Math.Min(delDia.Sum(t => t.DuracionMinutos) / total, 1);
    }

    private static string ResumenDelDia(DateTime dia, List<Turno> delDia, DateTime ahora)
    {
        if (delDia.Count == 0) return "Libre";

        if (dia.Date == ahora.Date)
        {
            var pendientes = delDia.Count(t => t.Estado == EstadoTurno.Programado && t.Fin > ahora);
            if (pendientes > 0) return pendientes == 1 ? "1 por atender" : $"{pendientes} por atender";
        }

        return delDia.Count == 1 ? "1 turno" : $"{delDia.Count} turnos";
    }

    private static string ClaseTurno(Turno turno, Turno? proximo)
    {
        var clase = turno.Estado switch
        {
            EstadoTurno.Atendido => "atendido",
            EstadoTurno.Ausente  => "ausente",
            _                    => "programado"
        };
        if (turno.PacienteId is null) clase += " sin-ficha";
        if (proximo is not null && turno.Id == proximo.Id) clase += " proximo";
        return clase;
    }

    private static string Meta(Turno turno, Turno? proximo, DateTime ahora)
    {
        var hora = turno.Inicio.ToString("HH:mm");
        var rango = $"{hora}–{turno.Fin:HH:mm}";

        if (turno.Estado == EstadoTurno.Ausente) return $"{rango} · Ausente";

        if (proximo is not null && turno.Id == proximo.Id)
        {
            var faltan = (int)Math.Ceiling((turno.Inicio - ahora).TotalMinutes);
            if (faltan <= 0) return $"{hora} · ahora";
            if (faltan <= 120) return $"{hora} · en {faltan} min";
        }

        if (turno.Paciente is null) return $"{rango} · Sin ficha";

        return string.IsNullOrWhiteSpace(turno.Paciente.ObraSocial)
            ? rango
            : $"{rango} · {turno.Paciente.ObraSocial}";
    }

    private static string NombreEstado(EstadoTurno estado) => estado switch
    {
        EstadoTurno.Atendido  => "Atendido",
        EstadoTurno.Ausente   => "Ausente",
        EstadoTurno.Cancelado => "Cancelado",
        _                     => "Programado"
    };

    private static string? NotaDelTurno(Turno turno)
    {
        if (turno.Estado == EstadoTurno.Atendido && !string.IsNullOrWhiteSpace(turno.NotaClinica))
            return turno.NotaClinica;
        return string.IsNullOrWhiteSpace(turno.Observaciones) ? null : turno.Observaciones;
    }

    /// <summary>
    /// Convierte la posicion vertical del mouse en minutos desde HoraInicio, al cuarto
    /// de hora en que cae el puntero. OffsetY es relativo al cuerpo del dia, que arranca
    /// justo debajo de la cabecera. Null si cae al final de la agenda.
    /// </summary>
    private double? MinutosEn(double offsetY)
    {
        var minutos = Math.Floor(offsetY / Escala / 15) * 15;
        if (minutos < 0) minutos = 0;
        return HoraInicio.ToTimeSpan().Add(TimeSpan.FromMinutes(minutos)) >= HoraFin.ToTimeSpan() ? null : minutos;
    }

    private DateTime MomentoDe(DateTime dia, double minutos) =>
        dia.Date.Add(HoraInicio.ToTimeSpan()).AddMinutes(minutos);

    /// <summary>
    /// El turno que ocupa ese momento, si hay uno. El margen a los costados de cada
    /// tarjeta deja ver el cuerpo del día, así que el mouse puede caer "en vacío"
    /// dentro del horario de un turno: ahí no hay lugar para uno nuevo.
    /// </summary>
    private Turno? TurnoEn(DateTime dia, double minutos)
    {
        var momento = MomentoDe(dia, minutos);
        return TurnosDe(dia).FirstOrDefault(t => t.Inicio <= momento && momento < t.Fin);
    }

    /// <summary>Alto del hueco "+ Nuevo turno": la duración por defecto, recortada si antes empieza otro turno.</summary>
    private double AltoFantasma(DateTime dia, double minutos)
    {
        var desde = MomentoDe(dia, minutos);
        var duracion = (double)Estado.DuracionPorDefecto;

        var siguiente = TurnosDe(dia).FirstOrDefault(t => t.Inicio > desde);
        if (siguiente is not null)
            duracion = Math.Min(duracion, (siguiente.Inicio - desde).TotalMinutes);

        return Math.Max(duracion * Escala - 3, 18);
    }

    private async Task ClickEnVacio(DateTime dia, MouseEventArgs e)
    {
        if (MinutosEn(e.OffsetY) is not { } minutos) return;

        if (TurnoEn(dia, minutos) is { } ocupado)
        {
            await AbrirTurno(ocupado);
            return;
        }

        await AlClickEnVacio.InvokeAsync(MomentoDe(dia, minutos));
    }

    private void AlMoverEnDia(DateTime dia, MouseEventArgs e)
    {
        var minutos = MinutosEn(e.OffsetY);
        if (minutos is { } m && TurnoEn(dia, m) is not null) minutos = null;
        if (fantasmaDia == dia && fantasmaMinutos == minutos) return;

        fantasmaDia = minutos is null ? null : dia;
        fantasmaMinutos = minutos;
        redibujar = true;
    }

    private void AlSalirDelDia()
    {
        if (fantasmaDia is null) return;
        fantasmaDia = null;
        fantasmaMinutos = null;
        redibujar = true;
    }

    private async Task AbrirTurno(Turno turno)
    {
        turnoBajoMouse = null;
        redibujar = true;
        await AlClickEnTurno.InvokeAsync(turno);
    }

    private void AlEntrarEnTurno(Turno turno)
    {
        turnoBajoMouse = turno;
        fantasmaDia = null;
        fantasmaMinutos = null;
        redibujar = true;
    }

    private void AlSalirDeTurno()
    {
        turnoBajoMouse = null;
        redibujar = true;
    }
}
