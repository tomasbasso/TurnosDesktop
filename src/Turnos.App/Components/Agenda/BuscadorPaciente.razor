@using Turnos.Core.Entidades
@using Turnos.Data.Servicios
@inject IPacienteService PacienteServicio

<div class="relative">
    @if (seleccionado is not null)
    {
        <div class="flex items-center gap-2 rounded-lg border border-marca-500 bg-marca-50 px-3 py-2">
            <span class="flex-1 text-sm font-medium text-marca-700">@seleccionado.NombreCompleto</span>
            <button class="text-xs text-stone-500 hover:text-stone-700" @onclick="Limpiar">cambiar</button>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(NombreLibre))
    {
        <div class="flex items-center gap-2 rounded-lg border border-stone-300 bg-stone-50 px-3 py-2">
            <span class="flex-1 text-sm font-medium text-stone-700">
                @NombreLibre <span class="font-normal text-stone-400">(sin ficha)</span>
            </span>
            <button class="text-xs text-stone-500 hover:text-stone-700" @onclick="Limpiar">cambiar</button>
        </div>
    }
    else
    {
        <input class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm"
               placeholder="Buscar paciente por apellido o DNI"
               @bind="texto" @bind:event="oninput" @bind:after="Buscar" />

        @if (candidatos.Count > 0)
        {
            <ul class="absolute z-30 mt-1 max-h-56 w-full overflow-auto rounded-lg border border-stone-200 bg-white shadow-lg">
                @foreach (var candidato in candidatos)
                {
                    <li class="cursor-pointer px-3 py-2 text-sm hover:bg-marca-50"
                        @onclick="@(() => Seleccionar(candidato))">
                        @candidato.NombreCompleto
                        @if (!string.IsNullOrWhiteSpace(candidato.Dni))
                        {
                            <span class="ml-2 text-xs text-stone-400">@candidato.Dni</span>
                        }
                    </li>
                }
            </ul>
        }

        @if (!string.IsNullOrWhiteSpace(texto) && candidatos.Count == 0)
        {
            <div class="mt-1 flex flex-col gap-1">
                <button class="w-full rounded-lg border border-dashed border-marca-500 px-3 py-2 text-sm text-marca-600 hover:bg-marca-50"
                        @onclick="@(() => mostrandoAlta = true)">
                    ＋ Dar de alta a "@texto"
                </button>
                <button class="w-full rounded-lg border border-dashed border-stone-300 px-3 py-2 text-sm text-stone-600 hover:bg-stone-50"
                        @onclick="UsarNombreLibre">
                    Usar solo el nombre "@texto", sin ficha
                </button>
            </div>
        }
    }
</div>

@if (mostrandoAlta)
{
    <div class="mt-3 rounded-lg border border-marca-100 bg-stone-50 p-3">
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">Paciente nuevo</h3>
        <FormPaciente Paciente="pacienteNuevo"
                      AlGuardar="AlAltaDePaciente"
                      AlCancelar="@(() => mostrandoAlta = false)" />
    </div>
}

@code {
    [Parameter] public int? PacienteId { get; set; }
    [Parameter] public string? NombreLibre { get; set; }
    [Parameter] public EventCallback<Paciente> PacienteSeleccionado { get; set; }
    [Parameter] public EventCallback<string> NombreLibreElegido { get; set; }
    [Parameter] public EventCallback Limpiado { get; set; }

    private string? texto;
    private List<Paciente> candidatos = [];
    private Paciente? seleccionado;
    private bool mostrandoAlta;
    private Paciente pacienteNuevo = new();

    protected override async Task OnParametersSetAsync()
    {
        if (PacienteId is not null and not 0 && seleccionado?.Id != PacienteId)
        {
            var resultado = await PacienteServicio.ObtenerAsync(PacienteId.Value);
            if (resultado.Success) seleccionado = resultado.Data;
        }
        else if (PacienteId is null or 0)
        {
            seleccionado = null;
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(texto)) { candidatos = []; return; }

        var resultado = await PacienteServicio.BuscarAsync(texto, limite: 8);
        if (resultado.Success) candidatos = resultado.Data!;
    }

    private async Task Seleccionar(Paciente paciente)
    {
        seleccionado = paciente;
        candidatos = [];
        texto = null;
        await PacienteSeleccionado.InvokeAsync(paciente);
    }

    private async Task Limpiar()
    {
        seleccionado = null;
        texto = null;
        candidatos = [];
        await Limpiado.InvokeAsync();
    }

    private async Task UsarNombreLibre()
    {
        var nombre = texto!.Trim();
        candidatos = [];
        texto = null;
        await NombreLibreElegido.InvokeAsync(nombre);
    }

    private async Task AlAltaDePaciente(Paciente paciente)
    {
        mostrandoAlta = false;
        pacienteNuevo = new Paciente();
        await Seleccionar(paciente);
    }
}
