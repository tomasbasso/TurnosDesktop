@inject NavigationManager Navegacion

<button class="group surface-card relative flex min-h-28 items-center gap-4 overflow-hidden rounded-2xl p-5 text-left hover:-translate-y-0.5 hover:border-marca-300 hover:shadow-lg"
        @onclick="@(() => Navegacion.NavigateTo(Ruta))">
    <span class="absolute -right-6 -top-7 h-24 w-24 rounded-full bg-marca-50 opacity-0 transition duration-300 group-hover:opacity-100"></span>
    <span class="relative flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-stone-100 text-stone-700 transition group-hover:rotate-[-4deg] group-hover:bg-marca-600 group-hover:text-white">
        @Icono
    </span>
    <span class="relative flex flex-1 flex-col gap-1">
        <span class="font-display text-lg font-semibold tracking-tight text-stone-800">@Titulo</span>
        <span class="text-xs leading-relaxed text-stone-500">@Subtitulo</span>
    </span>
    <span class="relative text-lg text-stone-300 transition group-hover:translate-x-0.5 group-hover:text-marca-600">→</span>
</button>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string Subtitulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment Icono { get; set; } = default!;
    [Parameter, EditorRequired] public string Ruta { get; set; } = string.Empty;
}
