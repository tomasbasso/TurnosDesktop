@inject NavigationManager Navegacion

<button class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-marca-300 hover:shadow-md"
        @onclick="@(() => Navegacion.NavigateTo(Ruta))">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-marca-50 text-marca-600 transition group-hover:bg-marca-100">
        @Icono
    </span>
    <span class="flex flex-col gap-0.5">
        <span class="font-display text-base font-semibold text-stone-800">@Titulo</span>
        <span class="text-xs text-stone-500">@Subtitulo</span>
    </span>
</button>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string Subtitulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment Icono { get; set; } = default!;
    [Parameter, EditorRequired] public string Ruta { get; set; } = string.Empty;
}
