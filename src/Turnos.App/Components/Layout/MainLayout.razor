@inherits LayoutComponentBase
@inject NavigationManager Navegacion

<div class="app-shell flex h-screen flex-col">
    <header class="app-topbar flex shrink-0 items-center gap-3 border-b border-stone-200/80 px-5 py-3">
        @if (Navegacion.ToBaseRelativePath(Navegacion.Uri) != "inicio")
        {
            <button class="soft-action rounded-xl px-3 py-1.5 text-xs font-semibold text-stone-600"
                    @onclick="@(() => Navegacion.NavigateTo("/inicio"))">
                ← Volver al inicio
            </button>
        }
        <div class="flex items-center gap-2">
            <span class="grid h-8 w-8 place-items-center rounded-xl bg-marca-600 font-display text-sm font-bold text-white shadow-sm">K</span>
            <div class="leading-tight">
                <span class="block font-display text-base font-semibold tracking-tight text-stone-800">Kinesiología</span>
                <span class="block text-[10px] font-medium tracking-wide text-stone-400">GESTIÓN CLÍNICA</span>
            </div>
        </div>
        <div class="ml-auto">
            <SelectorProfesional />
        </div>
    </header>

    <main class="flex min-h-0 flex-1 flex-col overflow-hidden">
        @Body
    </main>
</div>
