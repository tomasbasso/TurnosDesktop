@inherits LayoutComponentBase
@inject NavigationManager Navegacion

<div class="flex h-screen flex-col bg-stone-50">
    <header class="flex shrink-0 items-center gap-3 border-b border-stone-200 bg-white px-4 py-2.5">
        @if (Navegacion.ToBaseRelativePath(Navegacion.Uri) != "inicio")
        {
            <button class="rounded-lg px-2 py-1 text-stone-500 hover:bg-stone-100"
                    @onclick="@(() => Navegacion.NavigateTo("/inicio"))">
                ← Inicio
            </button>
        }
        <span class="font-display text-base font-semibold tracking-tight text-stone-800">Kinesiología</span>
        <div class="ml-auto">
            <SelectorProfesional />
        </div>
    </header>

    <main class="flex min-h-0 flex-1 flex-col overflow-hidden">
        @Body
    </main>
</div>
