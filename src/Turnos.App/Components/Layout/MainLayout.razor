@inherits LayoutComponentBase
@inject NavigationManager Navegacion
@inject EstadoApp Estado
@inject IJSRuntime JS

<div class="app-shell flex h-screen flex-col">
    <header class="app-topbar flex shrink-0 items-center gap-3 border-b border-stone-200/80 px-5 py-3">
        @if (Navegacion.ToBaseRelativePath(Navegacion.Uri) != "inicio")
        {
            <button class="soft-action rounded-xl px-3 py-1.5 text-xs font-semibold text-stone-600"
                    @onclick="@(() => Navegacion.NavigateTo("/inicio"))">
                ← Volver al inicio
            </button>
        }
        <div class="flex items-center gap-2">
            <span class="grid h-8 w-8 place-items-center rounded-xl bg-marca-600 font-display text-sm font-bold text-white shadow-sm">K</span>
            <div class="leading-tight">
                <span class="block font-display text-base font-semibold tracking-tight text-stone-800">Kinesiología</span>
                <span class="block text-[10px] font-medium tracking-wide text-stone-400">GESTIÓN CLÍNICA</span>
            </div>
        </div>
        <div class="ml-auto flex items-center gap-2">
            <button class="grid h-10 w-10 place-items-center rounded-2xl border border-stone-200 bg-white/80 text-stone-600 shadow-sm hover:text-stone-900"
                    title="@(EsNoche ? "Pasar a modo día" : "Pasar a modo noche")"
                    aria-label="@(EsNoche ? "Pasar a modo día" : "Pasar a modo noche")"
                    @onclick="CambiarTema">
                @if (EsNoche)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
                    </svg>
                }
            </button>
            <SelectorProfesional />
        </div>
    </header>

    <main class="flex min-h-0 flex-1 flex-col overflow-hidden">
        @Body
    </main>
</div>

@code {
    private bool EsNoche => Estado.Tema == "noche";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("turnosTema.aplicar", Estado.Tema);
    }

    private async Task CambiarTema()
    {
        Estado.Tema = EsNoche ? "dia" : "noche";
        await JS.InvokeVoidAsync("turnosTema.aplicar", Estado.Tema);
    }
}
