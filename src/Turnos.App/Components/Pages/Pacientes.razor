@page "/pacientes"
@using Turnos.Core.Entidades
@using Turnos.Data.Servicios
@inject IPacienteService PacienteServicio
@inject NavigationManager Navegacion

<div class="flex min-h-0 flex-1 flex-col p-6 md:p-8">
    <div class="mx-auto flex w-full max-w-4xl min-h-0 flex-1 flex-col">

        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="page-eyebrow mb-2">Padrón compartido</p>
                <h1 class="page-title">Pacientes</h1>
            </div>
            <span class="text-sm text-stone-500">@pacientes.Count registrados</span>
        </div>

        <div class="surface-card mb-4 flex gap-2 rounded-2xl p-2">
            <input class="input-control flex-1 rounded-xl px-3 py-2.5 text-sm"
                   placeholder="Buscar por apellido, nombre o DNI"
                   @bind="texto" @bind:event="oninput" @bind:after="Buscar" />
            <button class="primary-action rounded-xl px-4 py-2 text-sm font-semibold text-white"
                    @onclick="NuevoPaciente">＋ Nuevo paciente</button>
        </div>

        @if (enEdicion is not null)
        {
            <div class="surface-card mb-4 rounded-2xl border-marca-100 p-5">
                <h2 class="font-display mb-3 text-lg font-semibold tracking-tight text-stone-800">
                    @(enEdicion.Id == 0 ? "Nuevo paciente" : "Editar paciente")
                </h2>
                <FormPaciente Paciente="enEdicion"
                              AlGuardar="AlGuardarPaciente"
                              AlCancelar="@(() => enEdicion = null)" />
            </div>
        }

        <ul class="surface-card min-h-0 flex-1 divide-y divide-stone-100 overflow-auto rounded-2xl">
            @foreach (var paciente in pacientes)
            {
                <li class="group flex cursor-pointer items-center gap-3 px-5 py-3.5 transition hover:bg-marca-50/50"
                    @onclick="@(() => Editar(paciente))">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-stone-100 text-xs font-bold text-stone-600 group-hover:bg-white group-hover:text-marca-600">@(!string.IsNullOrWhiteSpace(paciente.NombreCompleto) ? paciente.NombreCompleto[..1] : "·")</span>
                    <span class="flex-1 text-sm font-semibold text-stone-800">@paciente.NombreCompleto</span>
                    @if (!string.IsNullOrWhiteSpace(paciente.ObraSocial))
                    {
                        <span class="rounded-lg bg-stone-100 px-2 py-1 text-xs font-medium text-stone-600">
                            @paciente.ObraSocial
                        </span>
                    }
                    <span class="hidden w-28 text-right text-xs text-stone-400 md:block">@paciente.Telefono</span>
                    <button class="rounded-lg px-2 py-1 text-xs font-semibold text-stone-500 hover:bg-white hover:text-marca-700"
                            @onclick="@(() => Navegacion.NavigateTo($"/pacientes/{paciente.Id}/historia"))"
                            @onclick:stopPropagation="true">📋 Historia</button>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    private List<Paciente> pacientes = [];
    private string? texto;
    private Paciente? enEdicion;

    protected override Task OnInitializedAsync() => Buscar();

    private async Task Buscar()
    {
        var resultado = await PacienteServicio.BuscarAsync(texto, limite: 200);
        if (resultado.Success) pacientes = resultado.Data!;
    }

    private void NuevoPaciente() => enEdicion = new Paciente();

    private void Editar(Paciente paciente) => enEdicion = new Paciente
    {
        Id = paciente.Id,
        Nombre = paciente.Nombre,
        Apellido = paciente.Apellido,
        Dni = paciente.Dni,
        Telefono = paciente.Telefono,
        Email = paciente.Email,
        FechaNacimiento = paciente.FechaNacimiento,
        ObraSocial = paciente.ObraSocial,
        NumeroAfiliado = paciente.NumeroAfiliado,
        Observaciones = paciente.Observaciones,
        Activo = paciente.Activo,
        CreadoEl = paciente.CreadoEl
    };

    private async Task AlGuardarPaciente(Paciente _)
    {
        enEdicion = null;
        await Buscar();
    }
}
