@page "/historia"
@using Turnos.Core.Entidades
@using Turnos.Data.Servicios
@inject IPacienteService PacienteServicio
@inject NavigationManager Navegacion

<div class="flex min-h-0 flex-1 flex-col p-6 md:p-8">
    <div class="mx-auto flex w-full max-w-md min-h-0 flex-1 flex-col">
        <p class="page-eyebrow mb-2">Seguimiento clínico</p>
        <h1 class="page-title mb-5">Historia clínica</h1>

        <input class="input-control mb-4 rounded-xl px-3 py-2.5 text-sm"
               placeholder="Buscar paciente por apellido, nombre o DNI"
               @bind="texto" @bind:event="oninput" @bind:after="Buscar" />

        @if (!string.IsNullOrWhiteSpace(texto) && pacientes.Count == 0)
        {
            <p class="surface-card rounded-2xl p-5 text-center text-sm text-stone-500">No se encontraron pacientes.</p>
        }
        else if (string.IsNullOrWhiteSpace(texto))
        {
            <p class="surface-card rounded-2xl p-5 text-center text-sm text-stone-500">Buscá un paciente para ver sus sesiones y evolución.</p>
        }
        else
        {
            <ul class="surface-card min-h-0 flex-1 divide-y divide-stone-100 overflow-auto rounded-2xl">
                @foreach (var paciente in pacientes)
                {
                    <li class="flex cursor-pointer items-center gap-3 px-4 py-3 transition hover:bg-marca-50/50"
                        @onclick="@(() => Navegacion.NavigateTo($"/pacientes/{paciente.Id}/historia"))">
                        <span class="flex-1 text-sm font-medium text-stone-800">@paciente.NombreCompleto</span>
                        @if (!string.IsNullOrWhiteSpace(paciente.Dni))
                        {
                            <span class="text-xs text-stone-400">@paciente.Dni</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private List<Paciente> pacientes = [];
    private string? texto;

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(texto)) { pacientes = []; return; }
        var resultado = await PacienteServicio.BuscarAsync(texto, limite: 20);
        if (resultado.Success) pacientes = resultado.Data!;
    }
}
