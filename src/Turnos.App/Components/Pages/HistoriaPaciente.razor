@page "/pacientes/{Id:int}/historia"
@implements IDisposable
@using Turnos.Core
@using Turnos.Core.Entidades
@using Turnos.Data.Servicios
@inject ITurnoService TurnoServicio
@inject IPacienteService PacienteServicio
@inject EstadoApp Estado
@inject NavigationManager Navegacion

<div class="flex min-h-0 flex-1 flex-col p-6">
    <div class="mx-auto flex w-full max-w-3xl min-h-0 flex-1 flex-col">

        <div class="mb-4 flex items-center gap-3">
            <button class="rounded-lg px-2 py-1 text-stone-500 hover:bg-stone-100"
                    @onclick="@(() => Navegacion.NavigateTo("/pacientes"))">←</button>
            @if (paciente is not null)
            {
                <div>
                    <h1 class="font-display text-lg font-semibold text-stone-800">@paciente.NombreCompleto</h1>
                    @if (!string.IsNullOrWhiteSpace(paciente.Dni))
                    {
                        <p class="text-xs text-stone-500">DNI @paciente.Dni</p>
                    }
                </div>
            }
        </div>

        @if (paciente is null)
        {
            <p class="text-sm text-stone-400">No se encontró el paciente.</p>
        }
        else if (filas.Count == 0)
        {
            <p class="rounded-xl border border-dashed border-stone-300 p-6 text-center text-sm text-stone-400">
                Este paciente todavía no tiene turnos con el profesional activo.
            </p>
        }
        else
        {
            <ul class="min-h-0 flex-1 space-y-3 overflow-auto">
                @foreach (var fila in filas)
                {
                    <li class="rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
                        <div class="mb-2 flex items-center gap-2">
                            <span class="text-sm font-medium text-stone-700">
                                @fila.Turno.Inicio.ToString("dddd d/MM/yyyy · HH:mm")
                            </span>
                            <span class="rounded-full px-2 py-0.5 text-xs font-medium text-white @ClaseEstado(fila.Turno.Estado)">
                                @fila.Turno.Estado
                            </span>
                        </div>

                        @if (fila.Turno.Estado == EstadoTurno.Atendido)
                        {
                            <textarea class="w-full resize-none rounded-lg border border-stone-300 p-2 text-sm"
                                      rows="3"
                                      placeholder="Qué se trabajó, cómo respondió, qué sigue."
                                      @bind="fila.NotaEditada" @bind:event="oninput"></textarea>
                            <div class="mt-2 flex items-center gap-2">
                                <button class="rounded-lg bg-marca-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-marca-700"
                                        @onclick="@(() => GuardarNota(fila))">Guardar</button>
                                @if (fila.Mensaje is not null)
                                {
                                    <span class="text-xs text-green-700">@fila.Mensaje</span>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Paciente? paciente;
    private List<FilaHistoria> filas = [];

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        Estado.Cambio += AlCambiarProfesional;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (paciente is null || paciente.Id != Id)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var pacienteResultado = await PacienteServicio.ObtenerAsync(Id);
        paciente = pacienteResultado.Success ? pacienteResultado.Data : null;

        var turnosResultado = await TurnoServicio.ObtenerPorPacienteAsync(Id, Estado.ProfesionalActivoId);
        filas = turnosResultado.Success
            ? turnosResultado.Data!.Select(t => new FilaHistoria(t)).ToList()
            : [];
    }

    private async Task GuardarNota(FilaHistoria fila)
    {
        var resultado = await TurnoServicio.GuardarNotaClinicaAsync(fila.Turno.Id, fila.NotaEditada);
        fila.Mensaje = resultado.Success ? "Guardada." : resultado.Message;
        if (resultado.Success)
            fila.Turno.NotaClinica = string.IsNullOrWhiteSpace(fila.NotaEditada) ? null : fila.NotaEditada.Trim();
    }

    private static string ClaseEstado(EstadoTurno estado) => estado switch
    {
        EstadoTurno.Atendido => "bg-green-600",
        EstadoTurno.Ausente => "bg-amber-500",
        EstadoTurno.Cancelado => "bg-stone-500",
        _ => "bg-sky-600"
    };

    private async void AlCambiarProfesional()
    {
        await InvokeAsync(async () =>
        {
            await CargarAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Estado.Cambio -= AlCambiarProfesional;

    private class FilaHistoria(Turno turno)
    {
        public Turno Turno { get; } = turno;
        public string? NotaEditada { get; set; } = turno.NotaClinica;
        public string? Mensaje { get; set; }
    }
}
